<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Preserve the original Settings page's dark card color. -->
            <Color x:Key="AppCardBackgroundColor">#FF1F1F1F</Color>
            <Color x:Key="AppCardBorderColor">Transparent</Color>
            <Color x:Key="AppSecondaryTextColor">#99FFFFFF</Color>
            <Color x:Key="AppReplacementTextColor">Orange</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppCardBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="AppCardBorderColor">#FFD7DEE7</Color>
            <Color x:Key="AppSecondaryTextColor">#FF576171</Color>
            <Color x:Key="AppReplacementTextColor">#FF9A4700</Color>
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFEEF1F5" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFF5F7FA" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFF7F9FC" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFEFF3F8" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFF7F9FC" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFEFF3F8" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFE5EBF3" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFF7F9FC" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFEFF3F8" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE5EBF3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="AppCardBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppCardBorderColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppSecondaryTextColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppReplacementTextColor" ResourceKey="SystemColorWindowTextColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{ThemeResource AppCardBackgroundColor}" />
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="{ThemeResource AppCardBorderColor}" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="{ThemeResource AppSecondaryTextColor}" />
    <SolidColorBrush x:Key="AppReplacementTextBrush" Color="{ThemeResource AppReplacementTextColor}" />

    <!-- The language manager is a settings row, including its collapsed header. -->
    <Thickness x:Key="ExpanderHeaderPadding">15</Thickness>
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{ThemeResource AppCardBackgroundColor}" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{ThemeResource AppCardBorderColor}" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="{ThemeResource AppCardBorderColor}" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="{ThemeResource AppCardBorderColor}" />

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppSecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
        <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="70" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
