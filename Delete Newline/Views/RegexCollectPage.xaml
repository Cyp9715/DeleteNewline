<Page x:Name="RootPage"
      x:Class="Delete_Newline.Views.RegexCollectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:structures="using:Delete_Newline.Contracts.Structures"
      xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:converters="using:Delete_Newline.Converters"
      Loaded="RegexCollectPage_Loaded"
      KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <converters:BooleanToFailedBrushConverter x:Key="BooleanToFailedBrushConverter" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F"
                             Modifiers="Control"
                             Invoked="SearchKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape"
                             Invoked="EscapeKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="RegexSearchOverlay"
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,5,0,5"
                Padding="10,6"
                CornerRadius="8"
                Visibility="Collapsed"
                Background="{ThemeResource SystemControlForegroundChromeMediumBrush}">
            <TextBox x:Name="RegexSearchTextBox"
                     Width="260"
                     PlaceholderText="Search by name"
                     TextChanged="RegexSearchTextBox_TextChanged"
                     KeyDown="RegexSearchTextBox_KeyDown"
                     LostFocus="RegexSearchTextBox_LostFocus" />
        </Border>

        <GridView x:Name="RegexConfigGridView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.FilteredRegexConfigs, Mode=OneWay}"
                  Padding="12"
                  SelectionMode="Extended"
                  CanReorderItems="{x:Bind ViewModel.CanReorderRegexConfigs, Mode=OneWay}"
                  CanDragItems="{x:Bind ViewModel.CanReorderRegexConfigs, Mode=OneWay}"
                  AllowDrop="True"
                  KeyDown="RegexConfigGridView_KeyDown">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="structures:RegexPageStructure">
                    <Border CornerRadius="5"
                            Margin="2"
                            Background="{ThemeResource SystemControlForegroundChromeMediumBrush}">
                        <Grid Width="310"
                              Height="90"
                              Padding="12,8,12,8"
                              RightTapped="RegexConfigCard_RightTapped"
                              Background="{ThemeResource SystemControlForegroundChromeMediumBrush}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                       Text="{Binding HotkeyName}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                       Text="{Binding Hotkey.DisplayText, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Top"
                                       Margin="8,0,0,0"
                                       Foreground="{Binding IsRegistrationFailed, 
                                        Converter={StaticResource BooleanToFailedBrushConverter}, 
                                        Mode=OneWay}" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                   Text="{Binding HotkeyComment}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,0" />
                            </Grid>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Remove"
                                                    Icon="Delete"
                                                    Click="RemoveRegexMenuFlyoutItem_Click">
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <behaviors:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="DoubleTapped">
                                    <core:InvokeCommandAction Command="{Binding DataContext.NavigateToRegexPageCommand, ElementName=RootPage}"
                                                              CommandParameter="{Binding}" />
                                </core:EventTriggerBehavior>
                            </behaviors:Interaction.Behaviors>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Button Grid.Row="1" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,24,24"
                Width="56" 
                Height="56" 
                CornerRadius="28"
                Background="{ThemeResource SystemAccentColor}"
                Command="{x:Bind ViewModel.AddRegexCommand}">
            <FontIcon Glyph="&#xE710;"
                      FontSize="20" />
        </Button>
    </Grid>
</Page>