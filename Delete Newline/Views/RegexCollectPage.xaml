<Page x:Name="RootPage"
      x:Class="Delete_Newline.Views.RegexCollectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:structures="using:Delete_Newline.Contracts.Structures"
      xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:converters="using:Delete_Newline.Converters">

    <Page.Resources>
        <converters:BooleanToFailedBrushConverter x:Key="BooleanToFailedBrushConverter" />
    </Page.Resources>

    <Grid>
        <GridView ItemsSource="{x:Bind ViewModel.RegexConfigs, Mode=OneWay}"
                  Padding="12"
                  CanReorderItems="True"
                  CanDragItems="True"
                  AllowDrop="True">

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="structures:RegexPageStructure">
                    <Border CornerRadius="5"
                            Margin="2"
                            Background="{ThemeResource SystemControlForegroundChromeMediumBrush}">
                        <Grid Width="310"
                              Height="90"
                              Padding="12"
                              Background="{ThemeResource SystemControlForegroundChromeMediumBrush}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Top">
                                <TextBlock Text="{Binding Hotkey.DisplayText, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="{Binding IsRegistrationFailed, Converter={StaticResource BooleanToFailedBrushConverter}, Mode=OneWay}" />
                                <TextBlock Text="{Binding HotkeyName}"
                                           FontWeight="SemiBold"
                                           FontSize="16" />
                                <TextBlock Text="{Binding HotkeyComment}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Remove"
                                                    Icon="Delete"
                                                    Command="{Binding DataContext.RemoveRegexCommand, ElementName=RootPage}"
                                                    CommandParameter="{Binding}">
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <behaviors:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="DoubleTapped">
                                    <core:InvokeCommandAction Command="{Binding DataContext.NavigateToRegexPageCommand, ElementName=RootPage}"
                                                              CommandParameter="{Binding}" />
                                </core:EventTriggerBehavior>
                            </behaviors:Interaction.Behaviors>
                        </Grid>
                    </Border>
                </DataTemplate>                    
            </GridView.ItemTemplate>
        </GridView>

        <Button Grid.Row="1" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,24,24"
                Width="56" 
                Height="56" 
                CornerRadius="28"
                Background="{ThemeResource SystemAccentColor}"
                Command="{x:Bind ViewModel.AddRegexCommand}">
            <FontIcon Glyph="&#xE710;"
                      FontSize="20" />
        </Button>
    </Grid>
</Page>