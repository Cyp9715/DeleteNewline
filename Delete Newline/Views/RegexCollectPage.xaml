<Page x:Name="RootPage"
      x:Class="Delete_Newline.Views.RegexCollectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:structures="using:Delete_Newline.Contracts.Structures"
      xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:converters="using:Delete_Newline.Converters"
      Loaded="RegexCollectPage_Loaded"
      KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <converters:BooleanToFailedBrushConverter x:Key="BooleanToFailedBrushConverter" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F"
                             Modifiers="Control"
                             Invoked="SearchKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Button x:Name="RegexSearchFocusSink"
                Width="1"
                Height="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Opacity="0"
                IsHitTestVisible="False"
                IsTabStop="True"
                UseSystemFocusVisuals="False"
                AutomationProperties.AccessibilityView="Raw" />

        <Border x:Name="RegexSearchOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Canvas.ZIndex="1"
                Visibility="Collapsed">
            <TextBox x:Uid="RegexCollect_SearchTextBox"
                     x:Name="RegexSearchTextBox"
                     Width="260"
                     PlaceholderText="Search by Name"
                     TextChanged="RegexSearchTextBox_TextChanged"
                     LostFocus="RegexSearchTextBox_LostFocus" />
        </Border>

        <GridView x:Name="RegexConfigGridView"
                  ItemsSource="{x:Bind ViewModel.FilteredRegexConfigs, Mode=OneWay}"
                  Padding="12,12,12,96"
                  SelectionMode="Extended"
                  CanReorderItems="{x:Bind ViewModel.CanReorderRegexConfigs, Mode=OneWay}"
                  CanDragItems="{x:Bind ViewModel.CanReorderRegexConfigs, Mode=OneWay}"
                  AllowDrop="True"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  KeyDown="RegexConfigGridView_KeyDown">

            <GridView.Resources>
                <Thickness x:Key="GridViewItemSelectedBorderThickness">3</Thickness>
                <CornerRadius x:Key="GridViewItemCornerRadius">5</CornerRadius>
                <x:Boolean x:Key="GridViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                <StaticResource x:Key="GridViewItemSelectedPointerOverBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
                <StaticResource x:Key="GridViewItemSelectedPressedBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            </GridView.Resources>

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left"
                                   ItemWidth="312" UseLayoutRounding="True" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="structures:RegexPageStructure">
                    <Border CornerRadius="5"
                            BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1"
                            Margin="2"
                            Background="{ThemeResource AppCardBackgroundBrush}">
                        <Grid Height="90"
                              Padding="12,8,12,8"
                              RightTapped="RegexConfigCard_RightTapped"
                              Background="{ThemeResource AppCardBackgroundBrush}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                       Text="{Binding HotkeyName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding HotkeyName}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                       Text="{Binding Hotkey.DisplayText, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Top"
                                       Margin="8,0,0,0"
                                       Foreground="{Binding IsRegistrationFailed, 
                                        Converter={StaticResource BooleanToFailedBrushConverter}, 
                                        Mode=OneWay}" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                   Text="{Binding HotkeyComment}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,0" />
                            </Grid>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Remove"
                                                    Icon="Delete"
                                                    Click="RemoveRegexMenuFlyoutItem_Click">
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <behaviors:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="DoubleTapped">
                                    <core:InvokeCommandAction Command="{Binding DataContext.NavigateToRegexPageCommand, ElementName=RootPage}"
                                                              CommandParameter="{Binding}" />
                                </core:EventTriggerBehavior>
                            </behaviors:Interaction.Behaviors>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Button Canvas.ZIndex="2"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,24,24"
                Width="56" 
                Height="56" 
                CornerRadius="28"
                Background="{ThemeResource SystemAccentColor}"
                Command="{x:Bind ViewModel.AddRegexCommand}">
            <FontIcon Glyph="&#xE710;"
                      FontSize="20" />
        </Button>
    </Grid>
</Page>
