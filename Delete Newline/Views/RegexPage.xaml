<Page x:Name="RootPage"
      x:Class="Delete_Newline.Views.RegexPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Delete_Newline"
      xmlns:helpers="using:Delete_Newline.Helpers"
      xmlns:hotkeys="using:Delete_Newline.Helpers.Hotkeys"
      xmlns:structures="using:Delete_Newline.Contracts.Structures"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:behaviors="using:Delete_Newline.Behaviors"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      mc:Ignorable="d">

    <ScrollViewer Margin="0">
        <Grid Padding="20,0,20,0">
            <StackPanel MaxWidth="900">
                <!-- Hotkey Settings Label -->
                <TextBlock x:Uid="RegexPage_Title_HotkeySettings"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontSize="16"
                           HorizontalAlignment="Left"
                           Margin="3,20,0,0"/>
                <!-- Hotkey Name, Comment, Input -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,5,0,0"
                        Padding="10">
                    <StackPanel>
                        <!-- Description -->
                        <TextBlock x:Uid="RegexPage_Description_HotkeySettings"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="5,0,0,10"/>
                        
                        <!-- Hotkey Name -->
                        <Grid Margin="5,0,0,0">
                            <TextBlock x:Uid="RegexPage_Label_HotkeyName" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBox_HotkeyName"
                                     Width="335"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Text="{Binding CurrentRegexConfig.HotkeyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Hotkey Comment -->
                        <Grid Margin="5,5,0,0">
                            <TextBlock x:Uid="RegexPage_Label_HotkeyComment" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBox_HotkeyComment"
                                     Width="335"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Text="{Binding CurrentRegexConfig.HotkeyComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Hotkey Input -->
                        <Grid Margin="5,5,0,0">
                            <TextBlock x:Uid="RegexPage_Label_HotkeyInput" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBox_Hotkey"
                                     Width="335"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     IsReadOnly="True"
                                     Text="{Binding DisplayHotkey, Mode=OneWay}">
                                <interactivity:Interaction.Behaviors>
                                    <behaviors:KeyboardInputBehavior CommandName="ProcessKeyInputCommand" />
                                    <core:EventTriggerBehavior EventName="GotFocus">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.GotFocusHotkeyTextBoxCommand}"/>
                                    </core:EventTriggerBehavior>
                                    <core:EventTriggerBehavior EventName="LostFocus">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.LostFocusHotkeyTextBoxCommand}"/>
                                    </core:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Regex Chain Label -->
                <TextBlock x:Uid="RegexPage_Title_RegexChain"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontSize="16"
                           HorizontalAlignment="Left"
                           Margin="3,20,0,0"/>
                <!-- Additional Regex Items -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,5,0,5"
                        Padding="10"
                        MinHeight="25">
                    <StackPanel>
                        <!-- Description -->
                        <TextBlock x:Uid="RegexPage_Description_RegexChain"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="5,0,0,10"/>
                        
                        <ItemsRepeater ItemsSource="{Binding CurrentRegexConfig.RegexChain.ChainItems}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="structures:ChainItem">
                                    <Grid Margin="5,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0"
                                              Grid.Column="0"
                                              Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="RegexPage_Label_RegexExpression"
                                                       VerticalAlignment="Center"
                                                       Grid.Column="0" />
                                            <TextBox Grid.Column="1"
                                                     Width="300"
                                                     TextAlignment="Center"
                                                     HorizontalAlignment="Right"
                                                     Text="{Binding RegexExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              Grid.Column="0"
                                              Margin="0,5,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="RegexPage_Label_Replace"
                                                       VerticalAlignment="Center"
                                                       Grid.Column="0" />
                                            <TextBox Grid.Column="1"
                                                     Width="300"
                                                     HorizontalAlignment="Right"
                                                     TextAlignment="Center"
                                                     Foreground="Orange"
                                                     Text="{Binding Replace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Button Width="30"
                                                Height="30"
                                                Padding="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="1"
                                                Margin="5,0,0,0"
                                                Command="{Binding DataContext.RemoveRegexItemCommand, ElementName=RootPage}"
                                                CommandParameter="{Binding}">
                                            <FontIcon Glyph="&#xE738;"
                                                      FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Grid>
                    <!-- Add Button -->
                    <Button x:Uid="RegexPage_Button_AddRegexItem"
                            Command="{Binding AddRegexItemCommand}"
                            Height="50"
                            Margin="1,0,1,0"
                            HorizontalAlignment="Stretch" />
                </Grid>

            <!-- Test Regex Chain Label -->
            <TextBlock x:Uid="RegexPage_Title_TestRegexChain"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       FontSize="16"
                       HorizontalAlignment="Left"
                       Margin="3,20,0,2"/>

            <!-- Regex Example Group within a Border -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,5,0,5"
                    Padding="10">
                <StackPanel>
                    <!-- Description -->
                    <TextBlock x:Uid="RegexPage_Description_TestRegexChain"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="5,0,0,10"/>

                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="5,0,0,10">
                        <Run x:Uid="RegexPage_Text_linebreak_Prefix" />
                        <Hyperlink NavigateUri="https://github.com/microsoft/microsoft-ui-xaml/issues/1826">
                            <Run x:Uid="RegexPage_Hyperlink_linebreak" />
                        </Hyperlink>
                        <Run x:Uid="RegexPage_Text_linebreak_Suffix" />
                    </TextBlock>

                        <Grid x:Name="Grid_RegexExample">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Input TextBox -->
                    <TextBox x:Name="TextBox_regexInput"
                             Grid.Row="0"
                             Margin="0,0,0,5"
                             Height="300"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             PointerWheelChanged="TextBox_PointerWheelChanged"
                             Text="{Binding CurrentRegexConfig.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Downward Arrow Icon -->
                    <FontIcon Grid.Row="1"
                              Glyph="&#xE0E5;" 
                              HorizontalAlignment="Center"
                              Margin="0,5,0,5"
                              FontSize="16"/>

                    <!-- Output TextBox -->
                    <TextBox x:Name="TextBox_regexOutput"
                             Grid.Row="2"
                             Margin="0,2,0,0"
                             Height="300"
                             Text="{Binding RegexOutputText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             PointerWheelChanged="TextBox_PointerWheelChanged" />
                </Grid>
                </StackPanel>
            </Border>

            </StackPanel>

            <!-- Dummy button for focus removal -->
            <Button x:Name="DummyFocusButton"
                    Opacity="0"
                    IsHitTestVisible="False"
                    IsTabStop="True"
                    Width="1" Height="1" />
        </Grid>
    </ScrollViewer>
</Page>
