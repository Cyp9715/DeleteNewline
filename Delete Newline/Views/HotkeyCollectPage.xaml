<Page x:Name="RootPage"
      x:Class="Delete_Newline.Views.HotkeyCollectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:structures="using:Delete_Newline.Contracts.Structures"
      xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core">

    <Grid>
        <GridView ItemsSource="{x:Bind ViewModel.HotkeyConfigs, Mode=OneWay}"
                  Padding="12"
                  CanReorderItems="True"
                  CanDragItems="True"
                  AllowDrop="True">

            <behaviors:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="DragItemsStarting">
                    <core:InvokeCommandAction Command="{x:Bind ViewModel.DragItemsStartingCommand}" />
                </core:EventTriggerBehavior>
                <core:EventTriggerBehavior EventName="DragItemsCompleted">
                    <core:InvokeCommandAction Command="{x:Bind ViewModel.DragItemsCompletedCommand}" />
                </core:EventTriggerBehavior>
            </behaviors:Interaction.Behaviors>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="structures:HotkeyPageStructure">
                    <Grid Width="310"
                          Height="90"
                          Margin="6"
                          Padding="12"
                          Background="{ThemeResource SystemControlForegroundChromeMediumBrush}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind HotkeyName}"
                                       FontWeight="SemiBold"
                                       FontSize="16" />
                            <TextBlock Text="{x:Bind HotkeyComment}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Remove"
                                                Icon="Delete"
                                                Command="{Binding DataContext.RemoveHotkeyCommand, ElementName=RootPage}"
                                                CommandParameter="{Binding}">
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <behaviors:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="DoubleTapped">
                                <core:InvokeCommandAction Command="{Binding DataContext.NavigateToHotkeyPageCommand, ElementName=RootPage}"
                                                          CommandParameter="{Binding}" />
                            </core:EventTriggerBehavior>
                        </behaviors:Interaction.Behaviors>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Button Grid.Row="1" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,24,24"
                Width="56" 
                Height="56" 
                CornerRadius="28"
                Background="{ThemeResource SystemAccentColor}"
                Command="{x:Bind ViewModel.AddHotkeyCommand}">
            <FontIcon Glyph="&#xE710;"
                      FontSize="20" />
        </Button>
    </Grid>
</Page>