<Page x:Name="RootPage"
      x:Class="Delete_Newline.Views.HotkeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:structures="using:Delete_Newline.Contracts.Structures"
      xmlns:behaviors="using:Delete_Newline.Behaviors"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      PointerPressed="HotkeyPage_PointerPressed">

    <ScrollViewer Margin="0">
        <Grid Padding="20,0,20,0">
            <StackPanel MaxWidth="800">
                <!-- Hotkey Settings Label -->
                <TextBlock Text="Hotkey Settings"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontSize="16"
                           HorizontalAlignment="Left"
                           Margin="3,20,0,0"/>
                <!-- Hotkey Name, Comment, Input -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,5,0,5"
                        Padding="10">
                    <StackPanel>
                        <!-- Hotkey Name -->
                        <Grid Margin="5,0,0,0">
                            <TextBlock Text="Hotkey Name" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBox_HotkeyName"
                                     Width="300"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Text="{Binding CurrentHotkeyConfig.HotkeyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Hotkey Comment -->
                        <Grid Margin="5,5,0,0">
                            <TextBlock Text="Hotkey Comment" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBox_HotkeyComment"
                                     Width="300"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Text="{Binding CurrentHotkeyConfig.HotkeyComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Hotkey Input -->
                        <Grid Margin="5,5,0,0">
                            <TextBlock Text="Hotkey" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBox_Hotkey"
                                     Width="300"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     IsReadOnly="True"
                                     Text="{Binding DisplayHotkey, Mode=OneWay}"
                                     GotFocus="TextBox_Hotkey_GotFocus"
                                     LostFocus="TextBox_Hotkey_LostFocus">
                                <interactivity:Interaction.Behaviors>
                                    <behaviors:KeyboardAcceleratorBehavior CommandName="HandleKeyboardAcceleratorCommand" />
                                </interactivity:Interaction.Behaviors>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Regex Chain Label -->
                <TextBlock Text="Regex Chain"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontSize="16"
                           HorizontalAlignment="Left"
                           Margin="3,15,0,0"/>
                <!-- Additional Regex Items -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,5,0,5"
                        Padding="10">
                    <StackPanel>
                        <ItemsRepeater ItemsSource="{Binding CurrentHotkeyConfig.RegexChain.ChainItems}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="structures:ChainItem">
                                    <Grid Margin="5,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Regex Expression -->
                                        <Grid Grid.Row="0"
                                              Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Regex Expression"
                                                       VerticalAlignment="Center"
                                                       Grid.Column="0" />
                                            <TextBox Grid.Column="1"
                                                     Width="265"
                                                     TextAlignment="Center"
                                                     HorizontalAlignment="Right"
                                                     Text="{Binding RegexExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <!-- Replace -->
                                        <Grid Grid.Row="1"
                                              Margin="0,5,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="└ Replace"
                                                       VerticalAlignment="Center"
                                                       Grid.Column="0" />
                                            <TextBox Grid.Column="1"
                                                     Width="265"
                                                     HorizontalAlignment="Right"
                                                     TextAlignment="Center"
                                                     Foreground="Red"
                                                     Text="{Binding Replace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <!-- Remove Button -->
                                        <Button Width="30"
                                                Height="30"
                                                Padding="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="1"
                                                Margin="5,0,0,0"
                                                Command="{Binding DataContext.RemoveRegexItemCommand, ElementName=RootPage}"
                                                CommandParameter="{Binding}">
                                            <FontIcon Glyph="&#xE738;"
                                                      FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Grid>
                    <!-- Add Button -->
                    <Button Content="Add Regex Item"
                            Command="{Binding AddRegexItemCommand}"
                            Height="50"
                            Margin="1,0,1,0"
                            HorizontalAlignment="Stretch" />
                </Grid>

            <!-- Test Regex Chain Label -->
            <TextBlock Text="Test Regex Chain"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       FontSize="16"
                       HorizontalAlignment="Left"
                       Margin="3,15,0,2"/>

            <!-- Regex Example Group within a Border -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,5,0,5"
                    Padding="10">
                <Grid x:Name="Grid_RegexExample">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Input TextBox -->
                    <TextBox x:Name="TextBox_regexInput"
                             Grid.Row="0"
                             Margin="0,0,0,5"
                             Height="300"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             PointerWheelChanged="TextBox_PointerWheelChanged"
                             Text="{Binding CurrentHotkeyConfig.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Downward Arrow Icon -->
                    <FontIcon Grid.Row="1"
                              Glyph="&#xE0E5;" 
                              HorizontalAlignment="Center"
                              Margin="0,5,0,5"
                              FontSize="16"/>

                    <!-- Output TextBox -->
                    <TextBox x:Name="TextBox_regexOutput"
                             Grid.Row="2"
                             Margin="0,2,0,0"
                             Height="300"
                             Text="{Binding RegexOutputText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             PointerWheelChanged="TextBox_PointerWheelChanged" />
                </Grid>
            </Border>

            </StackPanel>

            <!-- Dummy button for focus removal -->
            <Button x:Name="DummyFocusButton"
                    Opacity="0"
                    IsHitTestVisible="False"
                    IsTabStop="True"
                    Width="1" Height="1" />
        </Grid>
    </ScrollViewer>
</Page>
