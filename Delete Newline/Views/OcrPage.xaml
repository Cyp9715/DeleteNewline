<?xml version="1.0" encoding="utf-8"?>
<Page x:Name="RootPage"
      x:Class="Delete_Newline.Views.OCRPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Delete_Newline"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:behaviors="using:Delete_Newline.Behaviors"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      mc:Ignorable="d">

    <ScrollViewer Margin="0">
        <Grid Padding="20,0,20,0">
            <StackPanel MaxWidth="800">
                <!-- OCR Hotkey Settings Label -->
                <TextBlock x:Uid="OCRPage_Title_HotkeySettings"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontSize="16"
                           HorizontalAlignment="Left"
                           Margin="3,20,0,0"/>
                
                <!-- OCR Hotkey Configuration -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,5,0,0"
                        Padding="10">
                    <StackPanel>
                        <!-- Description -->
                        <TextBlock x:Uid="OCRPage_Description_HotkeySettings"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="5,0,0,0" />

                        <!-- Hotkey Input -->
                        <Grid Margin="5,10,0,0">
                            <TextBlock x:Uid="OCRPage_Label_Hotkey" 
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBox_OcrHotkey"
                                     Text="{Binding DisplayHotkey}"
                                     Width="300"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     IsReadOnly="True"
                                     x:Uid="HotkeyInput_Placeholder">
                                <interactivity:Interaction.Behaviors>
                                    <behaviors:KeyboardInputBehavior CommandName="ProcessKeyInputCommand" />
                                    <core:EventTriggerBehavior EventName="GotFocus">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.GotFocusHotkeyTextBoxCommand}"/>
                                    </core:EventTriggerBehavior>
                                    <core:EventTriggerBehavior EventName="LostFocus">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.LostFocusHotkeyTextBoxCommand}"/>
                                    </core:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OCR Language Settings Label -->
                <TextBlock x:Uid="OCRPage_Title_LanguageSettings"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontSize="16"
                           HorizontalAlignment="Left"
                           Margin="3,20,0,0"/>

                <!-- OCR Language Settings -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,5,0,0"
                        Padding="10">
                    <StackPanel>
                        <!-- Description -->
                        <TextBlock x:Uid="OCRPage_Description_LanguageSettings"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="5,0,0,0" />

                        <!-- Language Selection -->
                        <ComboBox x:Name="LanguageComboBox"
                                  HorizontalAlignment="Stretch"
                                  Margin="5,10,0,0"
                                  ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                                  SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Language Auto Installation -->
                        <Grid x:Name="InstallLanguageRow"
                              Margin="5,10,0,0"
                              ColumnSpacing="8"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="InstallLanguageComboBox"
                                      x:Uid="OCRPage_Header_InstallLanguage"
                                      Grid.Column="0"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.InstallableLanguages}"
                                      SelectedItem="{x:Bind ViewModel.SelectedInstallLanguage, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Uid="OCRPage_Button_InstallLanguage"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.InstallOcrLanguageCommand}"
                                    VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- Dummy button for focus removal during hotkey registration -->
            <Button x:Name="DummyFocusButton"
                    Opacity="0"
                    IsHitTestVisible="False"
                    IsTabStop="True"
                    Width="1" 
                    Height="1" />
        </Grid>
    </ScrollViewer>
</Page>
