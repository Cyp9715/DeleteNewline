<?xml version="1.0" encoding="utf-8"?>
<windowex:WindowEx  xmlns:windowex="using:WinUIEx"
                    x:Class="Delete_Newline.Views.OcrCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:Delete_Newline"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Text Grab"
        Width="800"
        Height="450"
        IsAlwaysOnTop="True"
        IsMaximizable="False"
        IsMinimizable="False"
        IsResizable="False"
        mc:Ignorable="d">

    <Grid x:Name="MainGrid">
        <!-- Desktop screenshot background -->
        <Image x:Name="BackgroundImage" Stretch="Fill" />
        
        <!-- Semi-transparent overlay that covers the entire screen -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <!-- Top overlay -->
            <Rectangle x:Name="TopOverlay" 
                       Fill="Black" 
                       Opacity="0.5" />
            
            <!-- Left overlay -->
            <Rectangle x:Name="LeftOverlay" 
                       Fill="Black" 
                       Opacity="0.5" />
            
            <!-- Right overlay -->
            <Rectangle x:Name="RightOverlay" 
                       Fill="Black" 
                       Opacity="0.5" />
            
            <!-- Bottom overlay -->
            <Rectangle x:Name="BottomOverlay" 
                       Fill="Black" 
                       Opacity="0.5" />
            
            <!-- Selection border -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="Teal"
                    BorderThickness="2"
                    Visibility="Collapsed" />
        </Canvas>
        
        <!-- Interaction layer -->
        <Canvas Name="RegionClickCanvas" Background="Transparent" />
    </Grid>
</windowex:WindowEx> 