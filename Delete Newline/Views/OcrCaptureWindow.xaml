<?xml version="1.0" encoding="utf-8"?>
<windowex:WindowEx  xmlns:windowex="using:WinUIEx"
                    x:Class="Delete_Newline.Views.OcrCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:Delete_Newline"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Text Grab"
        Width="800"
        Height="450"
        IsAlwaysOnTop="True"
        IsMaximizable="False"
        IsMinimizable="False"
        IsResizable="False"
        mc:Ignorable="d">

    <Grid x:Name="MainGrid">
        <!-- Desktop screenshot background - simple 1:1 match -->
        <Image x:Name="BackgroundImage" Stretch="Fill" />
        
        <!-- Semi-transparent overlay that covers the entire screen -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent" Canvas.ZIndex="0">
            <!-- Top overlay -->
            <Rectangle x:Name="TopOverlay" 
                       Fill="Black" 
                       Opacity="0.34" />
            
            <!-- Left overlay -->
            <Rectangle x:Name="LeftOverlay" 
                       Fill="Black" 
                       Opacity="0.34" />
            
            <!-- Right overlay -->
            <Rectangle x:Name="RightOverlay" 
                       Fill="Black" 
                       Opacity="0.34" />
            
            <!-- Bottom overlay -->
            <Rectangle x:Name="BottomOverlay" 
                       Fill="Black" 
                       Opacity="0.34" />
            
            <!-- Selection border -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="Teal"
                    BorderThickness="2"
                    Visibility="Collapsed" />
        </Canvas>
        
        <!-- Interaction layer -->
        <Canvas Name="RegionClickCanvas" Background="Transparent" Canvas.ZIndex="1" />

        <!-- OCR language selector shown during capture, similar to Windows snipping overlays. -->
        <Canvas x:Name="LanguageToolbarCanvas" Canvas.ZIndex="2">
            <Border x:Name="LanguageToolbar"
                    Width="360"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="#CC202020"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Uid="OcrCapture_LanguageLabel"
                               Text="OCR Language"
                               Foreground="White"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="CaptureLanguageComboBox"
                              MinWidth="220"
                              VerticalAlignment="Center"
                              SelectionChanged="CaptureLanguageComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</windowex:WindowEx> 