<Page x:Class="Delete_Newline.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core">

    <ScrollViewer Padding="15,0,15,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MaxWidth="800">

                <!-- StartOnTray Setting -->
                <Border Background="{ThemeResource SystemControlForegroundChromeMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,20,0,5"
                        Padding="15">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Uid="Settings_StartOnTray"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Settings_StartOnTray_Description"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="StartOnTrayToggleSwitch"
                                      IsOn="{x:Bind ViewModel.EnableStartOnTray}"
                                      Style="{StaticResource CompactToggleSwitch}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right">
                            <behaviors:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="Toggled">
                                    <core:InvokeCommandAction Command="{x:Bind ViewModel.ToggleStartOnTrayCommand}"
                                                              CommandParameter="{Binding IsOn, ElementName=StartOnTrayToggleSwitch}" />
                                </core:EventTriggerBehavior>
                            </behaviors:Interaction.Behaviors>
                        </ToggleSwitch>
                    </Grid>
                </Border>

                <!-- Theme Setting -->
                <Border Background="{ThemeResource SystemControlForegroundChromeMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,5"
                        Padding="15">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Uid="Settings_Theme"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Settings_Theme_Description"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="ThemeComboBox"
                                  Width="125"
                                  SelectedValue="{x:Bind ViewModel.SelectedTheme}"
                                  SelectedValuePath="Tag"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right">
                            <behaviors:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="SelectionChanged">
                                    <core:InvokeCommandAction Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                                              CommandParameter="{Binding SelectedValue, ElementName=ThemeComboBox}" />
                                </core:EventTriggerBehavior>
                            </behaviors:Interaction.Behaviors>
                            <ComboBoxItem x:Uid="Settings_Theme_Default" Tag="Default" />
                            <ComboBoxItem x:Uid="Settings_Theme_Light" Tag="Light" />
                            <ComboBoxItem x:Uid="Settings_Theme_Dark" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Language Setting -->
                <Border Background="{ThemeResource SystemControlForegroundChromeMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,5"
                        Padding="15">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Uid="Settings_Language"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Settings_Language_Description"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  x:Name="LanguageComboBox"
                                  Width="125"
                                  ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                                  SelectedItem="{x:Bind ViewModel.SelectedLanguage}"
                                  DisplayMemberPath="DisplayName"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right">
                            <behaviors:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="SelectionChanged">
                                    <core:InvokeCommandAction Command="{x:Bind ViewModel.SwitchLanguageCommand}"
                                                              CommandParameter="{Binding SelectedItem, ElementName=LanguageComboBox}" />
                                </core:EventTriggerBehavior>
                            </behaviors:Interaction.Behaviors>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Notification Setting -->
                <Border Background="{ThemeResource SystemControlForegroundChromeMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,5"
                        Padding="15">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Uid="Settings_Notification"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Settings_Notification_Description"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="NotificationToggleSwitch"
                                      IsOn="{x:Bind ViewModel.EnableNotification, Mode=TwoWay}"
                                      Style="{StaticResource CompactToggleSwitch}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right">
                            <behaviors:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="Toggled">
                                    <core:InvokeCommandAction Command="{x:Bind ViewModel.ToggleNotificationCommand}"
                                                              CommandParameter="{Binding IsOn, ElementName=NotificationToggleSwitch}" />
                                </core:EventTriggerBehavior>
                            </behaviors:Interaction.Behaviors>
                        </ToggleSwitch>
                    </Grid>
                </Border>

                <!-- TopMost Setting -->
                <Border Background="{ThemeResource SystemControlForegroundChromeMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,5"
                        Padding="15">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Uid="Settings_TopMost"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Settings_TopMost_Description"
                                       Opacity="0.6"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="TopMostToggleSwitch"
                                      IsOn="{x:Bind ViewModel.EnableTopMost}"
                                      Style="{StaticResource CompactToggleSwitch}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right">
                            <behaviors:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="Toggled">
                                    <core:InvokeCommandAction Command="{x:Bind ViewModel.ToggleTopMostCommand}"
                                                              CommandParameter="{Binding IsOn, ElementName=TopMostToggleSwitch}" />
                                </core:EventTriggerBehavior>
                            </behaviors:Interaction.Behaviors>
                        </ToggleSwitch>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 하단 동적 레이아웃 영역 -->
            <Grid x:Name="BottomPanel"
                  Grid.Row="1"
                  MaxWidth="800"
                  Margin="0,50,0,20"
                  HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 버튼 컨테이너 -->
                <StackPanel x:Name="ButtonContainer"
                            Grid.Column="0"
                            Width="800"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Left">
                    <Button x:Uid="Settings_ImportSettings"
                            Command="{x:Bind ViewModel.ImportSettingsCommand}"
                            Content="Import" />
                    <Button x:Uid="Settings_ExportSettings"
                            Command="{x:Bind ViewModel.ExportSettingsCommand}"
                            Content="Export" />
                </StackPanel>

                <!-- 버전 정보 -->
                <TextBlock x:Name="VersionText"
                           Grid.Column="1"
                           Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>