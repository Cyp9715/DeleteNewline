<Page x:Class="Delete_Newline.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
      xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      x:Uid="SettingsPage_Title">

    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        MaxWidth="500">

                <Line X1="0"
                      Y1="0"
                      X2="1000"
                      Y2="0"
                      Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                      StrokeThickness="1"
                      Margin="0,10,0,10" />

                <Grid Height="40">
                    <TextBlock x:Uid="Settings_StartOnTray"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="StartOnTrayToggleSwitch"
                                  HorizontalAlignment="Right"
                                  IsOn="{x:Bind ViewModel.EnableStartOnTray}"
                                  Style="{StaticResource CompactToggleSwitch}">
                        <behaviors:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="Toggled">
                                <core:InvokeCommandAction Command="{x:Bind ViewModel.ToggleStartOnTrayCommand}"
                                                          CommandParameter="{Binding IsOn, ElementName=StartOnTrayToggleSwitch}" />
                            </core:EventTriggerBehavior>
                        </behaviors:Interaction.Behaviors>
                    </ToggleSwitch>
                </Grid>

                <Grid Height="40">
                    <TextBlock x:Uid="Settings_Theme"
                               VerticalAlignment="Center" />

                    <ComboBox Width="125"
                              x:Name="ThemeComboBox"
                              HorizontalAlignment="Right"
                              SelectedValue="{x:Bind ViewModel.SelectedTheme}"
                              SelectedValuePath="Tag">
                        <behaviors:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="SelectionChanged">
                                <core:InvokeCommandAction Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                                          CommandParameter="{Binding SelectedValue, ElementName=ThemeComboBox}" />
                            </core:EventTriggerBehavior>
                        </behaviors:Interaction.Behaviors>
                        <ComboBoxItem x:Uid="Settings_Theme_Default"
                                      Tag="Default" />
                        <ComboBoxItem x:Uid="Settings_Theme_Light"
                                      Tag="Light" />
                        <ComboBoxItem x:Uid="Settings_Theme_Dark"
                                      Tag="Dark" />
                    </ComboBox>
                </Grid>

                <Grid Height="40">
                    <TextBlock x:Uid="Settings_Language"
                               VerticalAlignment="Center" />

                    <ComboBox Width="125"
                              x:Name="LanguageComboBox"
                              HorizontalAlignment="Right"
                              ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage}"
                              DisplayMemberPath="DisplayName">
                        <behaviors:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="SelectionChanged">
                                <core:InvokeCommandAction Command="{x:Bind ViewModel.SwitchLanguageCommand}"
                                                          CommandParameter="{Binding SelectedItem, ElementName=LanguageComboBox}" />
                            </core:EventTriggerBehavior>
                        </behaviors:Interaction.Behaviors>
                    </ComboBox>
                </Grid>

                <Grid Height="40">
                    <TextBlock x:Uid="Settings_Notification"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="NotificationToggleSwitch"
                                  IsOn="{x:Bind ViewModel.EnableNotification, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource CompactToggleSwitch}">

                        <behaviors:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="Toggled">
                                <core:InvokeCommandAction Command="{x:Bind ViewModel.ToggleNotificationCommand}"
                                                          CommandParameter="{Binding IsOn, ElementName=NotificationToggleSwitch}" />
                            </core:EventTriggerBehavior>
                        </behaviors:Interaction.Behaviors>

                    </ToggleSwitch>
                </Grid>

                <Grid Height="40">
                    <TextBlock x:Uid="Settings_TopMost"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="TopMostToggleSwitch"
                                  IsOn="{x:Bind ViewModel.EnableTopMost}"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource CompactToggleSwitch}">

                        <behaviors:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="Toggled">
                                <core:InvokeCommandAction Command="{x:Bind ViewModel.ToggleTopMostCommand}"
                                                          CommandParameter="{Binding IsOn, ElementName=TopMostToggleSwitch}" />
                            </core:EventTriggerBehavior>
                        </behaviors:Interaction.Behaviors>
                    </ToggleSwitch>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="1">
                <Button x:Uid="Settings_ImportSettings"
                        Command="{x:Bind ViewModel.ImportSettingsCommand}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Content="Import"
                        Margin="-500,0,0,20" />

                <Button x:Uid="Settings_ExportSettings"
                        Command="{x:Bind ViewModel.ExportSettingsCommand}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Content="Export"
                        Margin="-350,0,0,20" />

                <TextBlock Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="400,0,0,20" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>