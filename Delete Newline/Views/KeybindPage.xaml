<Page x:Class="Delete_Newline.Views.KeybindPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="550">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Regex Expression"
                               VerticalAlignment="Center"
                               Grid.Column="0" />
                    <TextBox x:Name="TextBox_regexExpression"
                             Grid.Column="1"
                             Width="250"
                             TextAlignment="Center"
                             HorizontalAlignment="Right" />

                    <TextBlock Text="Replace"
                               VerticalAlignment="Center"
                               Grid.Row="1" />
                    <TextBox x:Name="TextBox_regexReplace"
                             Grid.Row="1"
                             Grid.Column="1"
                             Width="250"
                             HorizontalAlignment="Right"
                             TextAlignment="Center"
                             Foreground="Red" />

                    <Button x:Name="Button_addRegex"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Margin="5,0,0,0">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="12" />
                    </Button>
                </Grid>

                <Grid x:Name="Grid_RegexExample"
                      Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="Label_regexInput"
                               Grid.Row="0"
                               Text="Input Text"
                               HorizontalAlignment="Right"
                               FontSize="12" />
                    <TextBox x:Name="TextBox_regexInput"
                             Grid.Row="1"
                             Margin="0,5,0,0"
                             Height="150"
                             AcceptsReturn="True" />

                    <TextBlock Grid.Row="2"
                               Text="Output Text"
                               Margin="0,5,0,0"
                               FontSize="12"
                               HorizontalAlignment="Right" />
                    <TextBox x:Name="TextBox_regexOutput"
                             Grid.Row="3"
                             Height="150"
                             IsReadOnly="True" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>